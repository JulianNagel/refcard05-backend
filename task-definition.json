{
  "family": "biztrips-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::851725276744:role/LabRole",
  "taskRoleArn": "arn:aws:iam::851725276744:role/LabRole",
  "containerDefinitions": [
    {
      "name": "biztrips-backend",
      "image": "851725276744.dkr.ecr.us-east-1.amazonaws.com/biztrips-backend:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "mariadb" },
        { "name": "DB_HOST", "value": "biztrips-db.cpio884825o3.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "3306" },
        { "name": "DB_NAME", "value": "db_biztrips" },
        { "name": "DB_USER", "value": "admin" },
        { "name": "DB_SSL_MODE", "value": "trust" },
        { "name": "APP_STORAGE_S3_BUCKET", "value": "biztrips-photos-851725276744" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:851725276744:secret:biztrips-db-password-O1Z4D5"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/biztrips-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
